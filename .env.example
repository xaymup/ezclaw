# Model Selection
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_BASE_URL=http://localhost:11434

# UI Settings
SHOW_THINKING=true

# Optimized Reasoning Settings
OLLAMA_TEMPERATURE=0.0
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=16384

# Performance Flags (Adjust based on your hardware)
OLLAMA_NUM_GPU=999
OLLAMA_NUM_THREAD=16
OLLAMA_NUM_BATCH=2048

# Use 60m for stable keep-alive
OLLAMA_KEEP_ALIVE=60m

# Database Path
DATABASE_PATH=ezclaw.db
