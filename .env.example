# Model Selection
OLLAMA_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434

# UI Settings
SHOW_THINKING=true

# Optimized Reasoning Settings
OLLAMA_TEMPERATURE=0.0
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=16384

# Performance Flags (Adjust based on your hardware)
OLLAMA_NUM_GPU=999
OLLAMA_NUM_THREAD=16
OLLAMA_NUM_BATCH=2048

# Use 60m for stable keep-alive
OLLAMA_KEEP_ALIVE=60m

# Timeout for Ollama API calls in seconds. Increase for slow models/hardware.
OLLAMA_TIMEOUT=300

# Multi-Agent Settings
ENABLE_MULTI_AGENT=true
OLLAMA_ARCHITECT_MODEL=phi4-reasoning:plus
OLLAMA_RESEARCHER_MODEL=qwen3:14b
OLLAMA_DEBUGGER_MODEL=deepseek-r1:14b
OLLAMA_GENERAL_MODEL=qwen3.5:9b

# Embedding Model (for semantic memory search & skill matching)
OLLAMA_EMBED_MODEL=mxbai-embed-large

# Database Path
DATABASE_PATH=ezclaw.db
